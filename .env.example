IMAGE_PREFIX=ghcr.io/antonharzhanau/social-network
APP_VERSION=v1.0.0
HTTP_BIND_IP=0.0.0.0
HTTP_PORT=8080
COMPOSE_PROFILES=

POSTGRES_DB=social_network
POSTGRES_USER=app
POSTGRES_PASSWORD=replace-with-a-url-safe-password
APP_SECRET=replace-with-a-random-secret
JWT_PASSPHRASE=replace-with-a-random-passphrase

MERCURE_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
MERCURE_PUBLIC_URL=https://social.projects.hardev.eu/.well-known/mercure
DEFAULT_URI=https://social.projects.hardev.eu

MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=replace-with-a-random-root-password
AWS_ACCESS_KEY_ID=social-network
AWS_SECRET_ACCESS_KEY=replace-with-a-random-storage-password
AWS_BUCKET=social-network-media
AWS_REGION=us-east-1

# Use the SMTP host listed for your IONOS mailbox (smtp.ionos.fr or smtp.ionos.com).
# Replace the password placeholder with the URL-encoded mailbox password.
MAILER_DSN=smtps://no-reply%40hardev.eu:replace-with-url-encoded-mailbox-password@smtp.ionos.fr:465
MAIL_FROM="Social Network <no-reply@hardev.eu>"
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

# Optional: tracking stays disabled while STATS_WEBSITE_ID is empty.
STATS_SCRIPT_URL=
STATS_WEBSITE_ID=
STATS_DOMAIN=
